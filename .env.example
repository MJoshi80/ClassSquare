# ── SMAY-ANUSARAN Environment Variables ──
# Copy this file to .env and update the values

# JWT Secret — change this to a long, random string in production
SECRET_KEY=smay-hackathon-secret-key-change-in-prod

# Database — SQLite for hackathon; swap to PostgreSQL connection string later
DATABASE_URL=sqlite:///./data/smay.db

# Token expiry in hours
ACCESS_TOKEN_EXPIRE_HOURS=8
